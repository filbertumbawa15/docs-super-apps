# Salin menjadi .env di ROOT repo (sejajar index.html), lalu isi nilainya.
# File .env tidak ikut ter-commit (.gitignore).

# Host API SKCK (tanpa garis miring di akhir)
API_HOST="https://HOST-API/admin-be"
APP_ID="isi-app-id"
ACCESS_KEY="isi-access-key"

# true jika API memakai sertifikat HTTPS internal / self-signed
INSECURE_TLS="true"

# Port lokal. Server hanya mendengar di 127.0.0.1 (tidak terbuka ke jaringan).
PORT="5173"
