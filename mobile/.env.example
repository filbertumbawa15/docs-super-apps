# Salin menjadi .env (di folder mobile/), isi nilainya, lalu jalankan:
#   flutter run --dart-define-from-file=.env
# File .env tidak ikut ter-commit (.gitignore). Jangan isi nilai asli di file contoh ini.

# Host API lookup admin-be (tanpa garis miring di akhir)
API_BASE=http://172.27.169.128/admin-be

# Kredensial API lookup (kosongkan keduanya bila API_BASE mengarah ke gateway /proxy)
APP_ID=isi-app-id
ACCESS_KEY=isi-access-key

# NIK pemohon yang SKCK-nya ditampilkan sebagai VC
NIK=isi-nik-16-digit

# Issuance API (token client_credentials). Diminta saat aplikasi dibuka.
ISSUER_TOKEN_URL=https://issuer.polri.go.id/api/v1/token
CLIENT_ID=isi-client-id
CLIENT_SECRET=isi-client-secret
